rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. User Profiles - strictly isolated to owner
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if false;

      // 2. Savings & Motherhood Fund profile
      // READ: User only.
      // WRITE: Clients are strictly FORBIDDEN from updating balances arbitrarily!
      // Create is allowed on initial onboarding with starting balance <= 120 GHS.
      match /savings/{savingsId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.currentBalance <= 120;
        allow update, delete: if false;
      }

      // 3. Transactions - immutable audit trail for user
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // 4. Affiliate Links
      match /affiliateLinks/{linkId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && request.resource.data.userId == userId;
        allow delete: if false;
      }

      // 5. Withdrawals - user can request demo withdrawal, cannot mark completed
      match /withdrawals/{withdrawalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.status == 'DEMO_REQUESTED';
        allow update, delete: if false;
      }

      // 6. AI Conversations
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // 7. Earn & Save Partners - Public read-only, authenticated write
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 8. Products - Public read-only, authenticated write
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 9. Consultants - Public read-only, authenticated write
    match /consultants/{consultantId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 10. Consultations - Booking requests
    match /consultations/{consultationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // 11. Hospitals - Public read-only, authenticated write
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 12. Community Groups & Support Circles
    match /communityGroups/{groupId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /posts/{postId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

        match /comments/{commentId} {
          allow read: if true;
          allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
        }
      }
    }

    // 13. Reports - Authenticated creation only, non-public read
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // 14. Direct Messaging
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // 15. App Configuration (e.g. appConfig/social for WhatsApp channel URL)
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /{subcollection=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
  }
}
